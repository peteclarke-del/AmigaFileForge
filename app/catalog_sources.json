  {
    "id": "itch-amiga",
    "name": "itch.io Amiga downloads",
    "type": "configured",
    "url": "https://itch.io/search",
    "machines": [
      "a500",
      "a500plus",
      "a600",
      "a1200",
      "a2000",
      "a3000",
      "a4000",
      "cd32",
      "amigaos"
    ],
    "enabled": true,
    "direct": true,
    "options": {
      "loader": "page",
      "parser": "html-cards",
      "queryTemplate": "?q={machineQuery}+{query}",
      "machineQueries": {
        "a500": "amiga 500",
        "a500plus": "amiga 500",
        "a600": "amiga 600",
        "a1200": "amiga 1200",
        "a2000": "amiga 2000",
        "a3000": "amiga 3000",
        "a4000": "amiga 4000",
        "cd32": "amiga cd32",
        "amigaos": "amigaos",
        "all": "amiga"
      },
      "cardClass": "game_cell",
      "titleClass": "game_title",
      "descriptionClass": "game_text",
      "publisherClass": "game_author",
      "resolver": "upload-buttons",
      "resolverOptions": {
        "mediaExtensions": [
          "adf",
          "adz",
          "dms",
          "hdf",
          "hda",
          "lha",
          "lzx",
          "hfe",
          "ipf"
        ],
        "archiveTerms": [
          "amiga",
          "adf",
          "whdload",
          "aga",
          "ocs",
          "ecs"
        ],
        "requestTemplate": "{pageUrl}/file/{uploadId}?source=view_game&as_props=1"
      },
      "resultValidationLimit": 40,
      "detailThreads": 6,
      "cacheSeconds": 3600
    }
  },
