# RPM packaging for Amiga File Forge.
#
# This mirrors the Debian package exactly: the same /opt/amiga-file-forge
# layout, the same vendored Python dependencies, the same desktop entry, icons,
# MIME types, AppStream record and manual page. Keeping the two layouts
# identical means a bug reproduced on one distribution is reproduced on the
# other, and the installed tree can be compared file for file.
#
# @VERSION@ and @RELEASE@ are substituted by tools/build-rpm-package.sh.

%global appname       amiga-file-forge
%global appdir        /opt/%{appname}
%global appid         uk.co.amigafileforge.AmigaFileForge
%global debug_package %{nil}

# The tree is prebuilt and vendored, so the usual byte-compilation, shebang
# mangling and dependency generation would rewrite files that are already
# pinned and verified.
%global __brp_python_bytecompile %{nil}
%global __brp_mangle_shebangs %{nil}
AutoReqProv: no

Name:           %{appname}
Version:        @VERSION@
Release:        @RELEASE@%{?dist}
Summary:        Amiga media image workshop

License:        MIT
URL:            https://github.com/peteclarke-del/AmigaFileForge
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  python3 >= 3.11
Requires:       python3 >= 3.11
Requires:       python3-gobject
Requires:       gtk4
Requires:       libadwaita
Requires:       webkitgtk6.0
Requires:       shared-mime-info
Requires:       desktop-file-utils

%description
Browse, edit, validate and convert Amiga, Amiga 600, Amiga 4000 and AmigaOS
disk, dms, ROM and hard-drive images from a native GTK application.

Supports OFS, FFS and AmigaDOS images, HDF banks, Hardfile HDA and GEO pairs,
DMS archives, HFE and SCP flux containers, expansion ROMs and Kickstart ROMs. With the
official Greaseweazle tools, or a host with a real floppy controller, disks can
also be read from and written to physical media.

%prep
%setup -q

%build
# The payload is assembled by tools/build-rpm-package.sh before packaging, so
# that the RPM and Debian trees are produced by one code path.

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}%{appdir}
cp -a opt/%{appname}/. %{buildroot}%{appdir}/
mkdir -p %{buildroot}%{_bindir}
ln -sf %{appdir}/bin/%{appname} %{buildroot}%{_bindir}/%{appname}
mkdir -p %{buildroot}%{_datadir}/applications
install -m 0644 usr/share/applications/%{appid}.desktop \
    %{buildroot}%{_datadir}/applications/
mkdir -p %{buildroot}%{_datadir}/metainfo
install -m 0644 usr/share/metainfo/%{appid}.metainfo.xml \
    %{buildroot}%{_datadir}/metainfo/
mkdir -p %{buildroot}%{_datadir}/mime/packages
install -m 0644 usr/share/mime/packages/%{appid}.xml \
    %{buildroot}%{_datadir}/mime/packages/
cp -a usr/share/icons %{buildroot}%{_datadir}/
mkdir -p %{buildroot}%{_mandir}/man1
install -m 0644 usr/share/man/man1/%{appname}.1.gz %{buildroot}%{_mandir}/man1/
mkdir -p %{buildroot}%{_docdir}/%{appname}
cp -a usr/share/doc/%{appname}/. %{buildroot}%{_docdir}/%{appname}/

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/%{appid}.desktop
if command -v appstreamcli >/dev/null 2>&1; then
    appstreamcli validate --no-net \
        %{buildroot}%{_datadir}/metainfo/%{appid}.metainfo.xml
fi

%post
/usr/bin/update-desktop-database &>/dev/null || :
/usr/bin/update-mime-database %{_datadir}/mime &>/dev/null || :
/usr/bin/gtk-update-icon-cache -qtf %{_datadir}/icons/hicolor &>/dev/null || :

%postun
/usr/bin/update-desktop-database &>/dev/null || :
/usr/bin/update-mime-database %{_datadir}/mime &>/dev/null || :
/usr/bin/gtk-update-icon-cache -qtf %{_datadir}/icons/hicolor &>/dev/null || :

%files
%license %{_docdir}/%{appname}/copyright
%doc %{_docdir}/%{appname}
%{appdir}
%{_bindir}/%{appname}
%{_datadir}/applications/%{appid}.desktop
%{_datadir}/metainfo/%{appid}.metainfo.xml
%{_datadir}/mime/packages/%{appid}.xml
%{_datadir}/icons/hicolor/*/apps/%{appname}.*
%{_mandir}/man1/%{appname}.1.gz

%changelog
* Fri Aug 28 2026 Amiga File Forge contributors <peteclarke-del@users.noreply.github.com> - @VERSION@-@RELEASE@
- Packaged from the shared Linux build tree used for the Debian package.
